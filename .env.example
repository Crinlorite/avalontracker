# Avalon Tracker — variables de entorno
# Copia a `.env` y rellena. Las marcadas con (*) son obligatorias.

# === Next.js / Auth ===
# (*) AUTH_SECRET: secreto JWT para NextAuth. Genera con `openssl rand -base64 32`.
AUTH_SECRET=change-me-to-32-bytes-random-base64
# (*) AUTH_URL: URL pública del sitio. En local: http://localhost:3000.
AUTH_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL: igual que AUTH_URL pero expuesta al cliente (build-time).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Discord OAuth ===
# Crea una app en https://discord.com/developers/applications.
# Pestaña OAuth2 → General. Añade redirect: <AUTH_URL>/api/auth/callback/discord
# (*) DISCORD_CLIENT_ID: Client ID de la app Discord.
DISCORD_CLIENT_ID=
# (*) DISCORD_CLIENT_SECRET: Client Secret de la app Discord.
DISCORD_CLIENT_SECRET=

# === Vigil Bot (servicio sibling, autoridad de roles) ===
# https://github.com/Crinlorite/vigil-discordbot — instala como guild bot y
# despliega en la misma red (o expone vía URL pública con HTTPS).
# (*) VIGIL_BOT_API_URL: URL del bot accesible desde el servidor.
VIGIL_BOT_API_URL=http://localhost:4000
# (*) VIGIL_BOT_SHARED_SECRET: secreto compartido para auth Bearer + HMAC de
# webhooks. Genera con `openssl rand -hex 32` y configura el MISMO valor en
# las env vars del bot.
VIGIL_BOT_SHARED_SECRET=change-me-to-32-bytes-random

# === Database ===
# (*) DATABASE_URL: PostgreSQL 16+. Prisma usa el adapter @prisma/adapter-pg.
DATABASE_URL=postgresql://user:pass@localhost:5432/avalon
# Pool size del cliente Prisma (default 5). Sube a 10-15 si multi-tenant.
PRISMA_CLIENT_POOL_SIZE=5

# === Feedback / tickets (opcional) ===
# Habilita el formulario en /feedback. Reenvía a Vigil Bot que crea ticket
# en Discord. Si los dejas vacíos, /feedback responde 500.
# FEEDBACK_SECRET puede ser igual a VIGIL_BOT_SHARED_SECRET o uno separado;
# debe coincidir con el del bot.
FEEDBACK_SECRET=
# VIGIL_BOT_URL: URL del Vigil Bot para reenviar tickets. Puede ser igual a
# VIGIL_BOT_API_URL o distinta si tienes proxies.
VIGIL_BOT_URL=

# === Cloudflare Turnstile (opcional, anti-bot en /feedback) ===
# Crea un widget en https://dash.cloudflare.com → Turnstile.
# Si los dejas vacíos, el form de feedback funciona sin verificación.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# === Misc ===
# Nivel de log de pino (debug, info, warn, error). Default: info en prod.
LOG_LEVEL=info
NODE_ENV=development

# === Enlaces de app (Android App Links) ===
# Huella(s) SHA-256 del certificado de firma de la app en Play Console
# (Configuración → Firma de la app). Separadas por comas. Vacío = sin App Links.
ANDROID_SIGNING_SHA256=
