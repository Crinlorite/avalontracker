# ============================================
# Variables de entorno para Coolify
# Copia estos valores en Coolify > App > Environment Variables
# ============================================

# PostgreSQL - Coolify te da esto al crear el servicio de DB
DATABASE_URL=postgresql://avalon:password@db:5432/avalon_tracker

# NextAuth - genera con: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://tu-dominio.com

# Google OAuth2 - https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL pública de la app
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# Tu email de Google (tendrás acceso al panel admin)
SUPER_ADMIN_EMAIL=
